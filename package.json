{
  "name": "aerovector-pilot-aptitude",
  "productName": "AeroVector Pilot Aptitude",
  "version": "2.3.0",
  "private": true,
  "description": "AeroVector pilot aptitude screening — Electron desktop hackathon application for Windows and macOS",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:portable": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:mac:arm64": "electron-builder --mac dmg zip --arm64",
    "dist:mac:x64": "electron-builder --mac dmg zip --x64",
    "dist:mac:universal": "electron-builder --mac dmg zip --universal"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.aerovector.pilotaptitude",
    "productName": "AeroVector Pilot Aptitude",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/aerovector.ico",
      "artifactName": "AeroVector-Pilot-Aptitude-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/aerovector.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "AeroVector-Pilot-Aptitude-${version}-mac-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false
    }
  }
}
